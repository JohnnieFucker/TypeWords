# 生产服务配置
NODE_ENV=production
NITRO_HOST=127.0.0.1
NITRO_PORT=3000

# 微信公众号 AppID 和 AppSecret；不要将真实密钥提交到代码仓库。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 必须是 HTTPS 公开地址，并与公众号网页授权域名和部署前缀一致。
WECHAT_CALLBACK_URL=https://example.com/api/auth/wechat/callback
# 可选：SQLite 持久化目录
TYPEWORDS_DATA_DIR=.data

# 可选：公开站点地址，用于页面链接
# NUXT_PUBLIC_ORIGIN=https://example.com
